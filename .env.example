# Copy this file to `.env` and fill in real values before running docker compose.
# All defaults below are placeholders — do NOT use them in production.

# --- PostgreSQL ---
POSTGRES_USER=hoopoe
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=hoopoe

# --- Backend ---
# Required, at least 32 characters, and unique to this install: it is the
# root key for sessions, 2FA, bank-sync, backup and MCP secrets. Generate with:
#   openssl rand -hex 32
# (install.sh does this for you.)
SESSION_SECRET=

# Only when changing SESSION_SECRET on an existing install: put the OLD value
# here for one boot. The backend re-encrypts 2FA, bank-sync, backup and MCP
# secrets under the new key, then logs that this line can be removed.
# SESSION_SECRET_PREVIOUS=

# Host ports. The frontend binds to every host interface (0.0.0.0) so other
# devices on your LAN can reach the app at http://<host-ip>:${FRONTEND_PORT};
# see SECURITY.md ("Threat model") before exposing beyond the host. To keep
# access local, restrict with a host firewall, or edit docker-compose.yml
# and prefix the frontend port with "127.0.0.1:" (e.g. "127.0.0.1:8000:8080").
# The backend port is published on 127.0.0.1 only; LAN clients (browsers,
# the MCP server) reach the API through the frontend's nginx at /api/*.
# Avoid 6000 / 6666 / 6665-6669 / 6697 — Chrome blocks them as ERR_UNSAFE_PORT.
FRONTEND_PORT=8000
BACKEND_PORT=8001

# Whether new accounts can be created once the first user exists. The first
# account (onboarding) is always allowed. Set to false once everyone in the
# household has an account, so other devices on the LAN cannot sign up.
ALLOW_REGISTRATION=true

# Reverse-proxy hops the backend trusts for the client address
# (X-Forwarded-For). Compose defaults to "loopback,uniquelocal", which covers
# the bundled nginx on the private Docker network. Only change it if you
# know which proxy sits in front of the backend.
# TRUST_PROXY=loopback,uniquelocal

# Set to true when running behind an HTTPS-terminating reverse proxy. On a
# plain-HTTP LAN deployment, leave false — otherwise the session cookie is
# rejected by the browser and login silently fails.
COOKIE_SECURE=false

# Bearer token for /metrics. When set (>= 16 chars), the endpoint requires
# `Authorization: Bearer <token>`. When unset, /metrics is disabled (404)
# unless METRICS_PUBLIC=true. Generate with `openssl rand -hex 32`.
# METRICS_TOKEN=replace-me-with-at-least-16-random-characters
# Serve /metrics without authentication when METRICS_TOKEN is unset. It
# exposes cross-user counts and backup timestamps, so only enable it on a
# trusted LAN. Ignored when METRICS_TOKEN is set.
# METRICS_PUBLIC=true

# Opt-in watch-folder importer. When set, the backend polls this directory
# every 60 s and imports any .ofx/.qfx/.csv/.pdf dropped into a subfolder
# named after the destination account (case- and accent-insensitive), e.g.
# $WATCH_IMPORTS_DIR/Compte courant/mai.pdf. Files are renamed in place to
# record the outcome: .imported, .failed (+ a sibling .error.txt), or
# .needs-template for PDFs that still need the interactive wizard. In Docker,
# mount the folder into the backend container and point this at the mount.
# WATCH_IMPORTS_DIR=/data/watch-imports

# Nightly unattended bank sync (Enable Banking connector). When credentials
# are configured in Réglages, the backend syncs every mapped bank connection
# once a day. Set to 0 to disable the scheduler and only sync on demand from
# the UI (POST /api/bank-sync/sync).
# BANK_SYNC_AUTO=1

# Scheduled remote backups (Sauvegarde → Sauvegarde distante). When a
# destination is configured, the backend pushes an encrypted backup once a
# day at the user's chosen hour. Set to 0 to disable the scheduler; the
# "Sauvegarder maintenant" button still works.
# BACKUP_AUTO=1

# Built-in mDNS/Bonjour responder for `<HOOPOE_MDNS_HOSTNAME>.local`.
# On by default — other devices on the LAN can reach the app at
# http://hoopoe.local:${FRONTEND_PORT} without a static DNS entry. The
# responder fails soft when UDP 5353 is already bound by the OS stack
# (macOS mDNSResponder / avahi-daemon): a startup warning is logged
# and the OS keeps serving `<Mac-name>.local` as before. In Docker this
# needs the container on the host network (network_mode: host on Linux);
# the default bridge driver blocks multicast. Set to 0 to disable.
# HOOPOE_MDNS=1
# HOOPOE_MDNS_HOSTNAME=hoopoe

# Timezone of the backend container (IANA name, e.g. Europe/Paris). Without
# it the container runs on UTC, so schedule-based features — notably the
# bank-sync "retrieval hour" — fire at UTC hours instead of your wall-clock
# time (09:00 configured → 11:00 CEST). Set it to your server's timezone.
# TZ=Europe/Paris
