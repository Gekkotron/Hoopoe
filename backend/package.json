    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.0",
    "@napi-rs/canvas": "^0.1.55",
    "@node-rs/argon2": "^2.2.2",
    "content-disposition": "^2.0.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
