    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.3.1",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.28.0"
